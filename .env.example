# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
#
# ".env" is git-ignored so your key never ends up in the repository.
# ---------------------------------------------------------------------------

# Your AudD API token. Get one at https://dashboard.audd.io/
#
# IMPORTANT: this variable has NO "VITE_" prefix on purpose.
# Vite only exposes variables starting with "VITE_" to browser code, so keeping
# the name as-is guarantees the token stays on the server (the /api function)
# and is never shipped in the JavaScript bundle.
AUDD_API_TOKEN=your_audd_api_token_here
